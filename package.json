{
  "name": "pi-desktop",
  "version": "1.2.1",
  "private": true,
  "description": "A local-first desktop workbench for the pi coding agent",
  "main": "dist-electron/main/index.js",
  "author": "zth0828",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/zth0828/pi-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zth0828/pi-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/zth0828/pi-desktop/issues"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "ai-coding",
    "desktop",
    "electron",
    "react",
    "developer-tools",
    "local-first",
    "mcp"
  ],
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local-pi": "node scripts/dev-with-local-pi.mjs",
    "build:vite": "vite build",
    "build": "pnpm run build:vite && electron-builder --dir",
    "dist": "pnpm run build:vite && electron-builder --publish never",
    "dist:mac": "pnpm run build:vite && electron-builder --mac --publish never",
    "dist:win": "pnpm run build:vite && electron-builder --win --publish never",
    "dist:linux": "pnpm run build:vite && electron-builder --linux --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build:vite && playwright test",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:contract:min": "PI_TEST_VERSION=0.83.0 pnpm test:contract",
    "test:contract:recommended": "PI_TEST_VERSION=0.84.2 pnpm test:contract",
    "test:contract:latest": "PI_TEST_VERSION=latest pnpm test:contract",
    "screenshots:readme": "pnpm run build:vite && node scripts/capture-readme-screenshots.mjs"
  },
  "piCompat": {
    "min": "0.83.0",
    "tested": [
      "0.83.x",
      "0.84.x"
    ],
    "fallback": "0.84.2"
  },
  "dependencies": {
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "dompurify": "^3.4.13",
    "electron-store": "^11.0.2",
    "i18next": "^26.3.6",
    "ignore": "^7.0.6",
    "katex": "^0.18.1",
    "lucide-react": "^1.29.0",
    "mammoth": "^1.12.1",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.11",
    "read-excel-file": "^9.3.10",
    "streamdown": "^2.5.0",
    "undici": "^8.10.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "40.10.6",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10"
  }
}
